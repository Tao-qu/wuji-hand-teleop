# Home joint angles: degrees.
left_arm:
  home_joints: [55.0, -65.0, -70.0, -60.0, 60.0, 0.0, 0.0]

right_arm:
  home_joints: [-55.0, -65.0, 70.0, -60.0, -60.0, 0.0, 0.0]

driver:
  robot_ip: "192.168.1.190"
  kinematics_model: "ccs_m6.MvKDCfg"
  # Flange -> virtual hand-back TCP, mm; TCP axes parallel to flange axes.
  # Approximate mounting: +Z toward fingers; dorsal -Y left, +Y right.
  tool_transforms:
    left:
      - [1, 0, 0, 0]
      - [0, 1, 0, -50]
      - [0, 0, 1, 70]
      - [0, 0, 0, 1]
    right:
      - [1, 0, 0, 0]
      - [0, 1, 0, 50]
      - [0, 0, 1, 70]
      - [0, 0, 0, 1]
  tool_dynamics:
    source: controller

controller:
  control_rate: 120.0
  state_publish_rate: 500.0
  home_duration_sec: 8.0
  handoff_hold_sec: 0.5
  handoff_ramp_sec: 1.0

openvr:
  calibration_file: "tracker-neutral.yaml"
  tracker_serials:
    chest: "LHR-XXXXXXXX"
    left_hand_back: "LHR-XXXXXXXX"
    right_hand_back: "LHR-XXXXXXXX"
    left_arm: "LHR-XXXXXXXX"
    right_arm: "LHR-XXXXXXXX"
  publish_rate_hz: 120.0
  publish_tf: true
  parent_frame: "world"
