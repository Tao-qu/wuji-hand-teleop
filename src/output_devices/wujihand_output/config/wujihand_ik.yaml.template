# Wuji Hand hardware configuration for MANUS teleoperation.
# ===== Wuji Hand hardware =====
# Find serials with: lsusb -v -d 0483:2000 | grep iSerial
left_hand:
  serial_number: "YOUR_LEFT_HAND_SERIAL"
  name: "left_hand"           # wujihandros2 driver namespace

right_hand:
  serial_number: "YOUR_RIGHT_HAND_SERIAL"
  name: "right_hand"          # wujihandros2 driver namespace

# ===== wujihandros2 driver parameters =====
driver:
  publish_rate: 1000.0        # driver publish rate (Hz)
  filter_cutoff_freq: 10.0    # hardware low-pass filter cutoff (Hz)
  diagnostics_rate: 10.0      # diagnostics publish rate (Hz)
