# OpenVR Tracker Input Configuration
# ==================================

# Tracker serial numbers
# Run the following command to get your tracker serial numbers:
#   python3 -c "import openvr; openvr.init(openvr.VRApplication_Other); vr=openvr.VRSystem(); [print(f'{i}: {vr.getStringTrackedDeviceProperty(i, openvr.Prop_SerialNumber_String)}') for i in range(64) if vr.getTrackedDeviceClass(i)==openvr.TrackedDeviceClass_GenericTracker]; openvr.shutdown()"
tracker_serials:
  chest: "LHR-XXXXXXXX"        # Chest
  right_wrist: "LHR-XXXXXXXX"  # Right wrist
  left_wrist: "LHR-XXXXXXXX"   # Left wrist
  left_arm:  "LHR-XXXXXXXX"    # Left upper arm
  right_arm:   "LHR-XXXXXXXX"   # Right upper arm


# Wrist tracker offset in tracker's local frame [x, y, z] (meters)
# This offset is applied BEFORE coordinate correction to map tracker position to actual wrist
# Adjust these values based on how the tracker is mounted relative to your wrist
# Example: if tracker is 5cm above wrist along tracker's -Z axis, use [0, 0, -0.05] The Z axis is go straight down
# wrist_offset: [0.0, 0.04, 0.05]

# For human data record system, the trackers are replaced
wrist_offset: [0.0, -0.00275, 0.0535]

# Columns are calibrated-frame axes in the raw upper-arm tracker frame.
# Mirrored mounting fit paired with static_transforms.yaml; Y is the arm reference.
upper_arm_rotations:
  left_arm:
    - [0.9558169572148534, 0.2937424061670544, -0.011372911664506212]
    - [-0.2937424061670544, 0.9528895191848917, -0.07561060141789232]
    - [-0.011372911664506212, 0.07561060141789232, 0.9970725619700385]
  right_arm:
    - [0.9558169572148534, -0.2937424061670544, 0.011372911664506212]
    - [0.2937424061670544, 0.9528895191848917, -0.07561060141789232]
    - [0.011372911664506212, 0.07561060141789232, 0.9970725619700385]

# Publishing settings
publish_rate_hz: 120.0

# TF settings
publish_tf: true
parent_frame: "world"
