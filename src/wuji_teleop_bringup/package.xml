<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wuji_teleop_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files for Wuji Hand and Tianji Arm teleoperation system.
  </description>
  <maintainer email="support@wuji.tech">Wuji Tech</maintainer>
  <license>MIT</license>


  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>manus_ros2_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <exec_depend>controller</exec_depend>
  <exec_depend>openvr_input</exec_depend>
  <exec_depend>tianji_output</exec_depend>
  <exec_depend>wuji_hand2_driver</exec_depend>
  <exec_depend>wuji_hand2_2_description</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- Package dependencies -->
  <exec_depend>manus_ros2</exec_depend>
  <exec_depend>wujihand_output</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
