<?xml version="1.0"?>
<package format="3">
  <name>wuji_hand2_driver</name>
  <version>0.1.0</version>
  <description>Guarded ROS 2 adapter for the official Wuji Hand 2 SDK.</description>
  <maintainer email="support@wuji.tech">Teleoperation maintainers</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>wuji_hand2_2_description</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
