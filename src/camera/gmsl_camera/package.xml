<?xml version="1.0"?>
<package format="3">
  <name>gmsl_camera</name>
  <version>0.1.0</version>
  <description>Independent full-resolution Argus streams for the Tianji GMSL cameras.</description>
  <maintainer email="taoqu@users.noreply.github.com">Tao Qu</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>libgstreamer1.0-dev</depend>
  <depend>libgstreamer-plugins-base1.0-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>
  <build_depend>pkg-config</build_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
