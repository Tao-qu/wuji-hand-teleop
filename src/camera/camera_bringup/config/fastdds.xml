<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>camera_shm</transport_id>
        <type>SHM</type>
        <segment_size>268435456</segment_size>
        <port_queue_capacity>8192</port_queue_capacity>
        <maxMessageSize>16777216</maxMessageSize>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>camera_udp</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="camera_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>camera_shm</transport_id>
          <transport_id>camera_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
