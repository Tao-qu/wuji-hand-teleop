<?xml version="1.0"?>
<package format="3">
  <name>data_collection</name>
  <version>0.1.0</version>
  <description>Independent continuous LeRobot v2.1 recording for Tianji and Wuji Hand 2.</description>
  <maintainer email="dev@wuji.com">Wuji Robotics</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>data_collection_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
